{
  "name": "n8n-nodes-linkednav",
  "version": "0.1.0",
  "description": "n8n community node for LinkedNav: LinkedIn outreach campaigns, leads, inbox and approvals, and your own LinkedIn account. Not affiliated with LinkedIn.",
  "license": "MIT",
  "homepage": "https://linkednav.com",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "LinkedNav",
    "email": "cynthia@linkednav.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linglistack/n8n-nodes-linkednav.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "generate": "node scripts/generate.mjs && prettier --write nodes/LinkedNav/actions.ts"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LinkedNavApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LinkedNav/LinkedNav.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
